<Highlighting>
    <Name>C++</Name>
    <Patterns>
        <Pattern>
            <Name>controlflow</Name>
            <Match>break|case|catch|continue|default|do|else|for|goto|if|return|switch|throw|try|while|co_await|co_return|co_yield</Match>
			<Color>#db03fc</Color>
        </Pattern>
        <Pattern>
            <Name>keywords</Name>
            <Match>alignof|alignas|asm|auto|class|consteval|constinit|constexpr|const_cast|decltype|delete|dynamic_cast|enum|explicit|false|final|friend|inline|namespace|new|noexcept|nullptr|operator|override|private|protected|public|reinterpret_cast|sizeof|static_assert|static_cast|struct|template|this|true|typedef|typeid|typename|union|using|virtual|and|and_eq|bitand|bitor|compl|not|not_eq|or|or_eq|xor|xor_eq|concept|requires|import|module|export</Match>
        </Pattern>
        <Pattern>
            <Name>attributes</Name>
            <Match>noreturn|carries_dependency|deprecated|fallthrough|nodiscard|maybe_unused|likely|unlikely|no_unique_address|assume</Match>
        </Pattern>
        <Pattern>
            <Name>types</Name>
            <Match>bool|char|char8_t|char16_t|char32_t|double|float|int|long|short|signed|unsigned|void|int8_t|int16_t|int32_t|int64_t|uint8_t|uint16_t|uint32_t|uint64_t|int_least8_t|int_least16_t|int_least32_t|int_least64_t|uint_least8_t|uint_least16_t|uint_least32_t|uint_least64_t|int_fast8_t|int_fast16_t|int_fast32_t|int_fast64_t|uint_fast8_t|uint_fast16_t|uint_fast32_t|uint_fast64_t|size_t|size_t|wchar_t|intptr_t|uintptr_t|intmax_t|uintmax_t|ptrdiff_t|sig_atomic_t|wint_t|va_list|FILE|fpos_t|time_t</Match>
        </Pattern>
        <Pattern>
            <Name>modifiers</Name>
            <Match>const|extern|mutable|register|static|thread_local|volatile</Match>
        </Pattern>
        <Pattern>
            <Name>preprocessor</Name>
            <Match>#\s*(include|define|undef|if|ifdef|ifndef|else|elif|endif|error|pragma)\b</Match>
        </Pattern>
        <Pattern>
            <Name>comment</Name>
            <Match>//</Match>
        </Pattern>
        <Pattern>
            <Name>multiline comment</Name>
            <Begin>/\*</Begin>
            <End>\*/</End>
        </Pattern>
    </Patterns>
</Highlighting>